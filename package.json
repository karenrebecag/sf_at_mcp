{
  "name": "salesforce-atfx-mcp",
  "version": "0.2.0",
  "description": "Remote read-only MCP connector for Claude web — queries the ATFX Salesforce org via the locally-authenticated sf CLI (SOQL, describe, org info)",
  "type": "module",
  "private": true,
  "bin": {
    "salesforce-atfx-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:local": "tsx scripts/run-smoke-local.ts",
    "predeploy": "pnpm verify && pnpm build && pnpm smoke:local"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.4.0",
    "vitest": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
