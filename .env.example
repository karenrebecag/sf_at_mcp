# Shared secret that gates the connector. The Claude web connector URL is:
#   https://<your-host>/<MCP_ACCESS_TOKEN>/mcp
# Anyone with that URL can query as the CLI-authenticated user — keep it secret.
# Generate: openssl rand -hex 24
MCP_ACCESS_TOKEN=

# Salesforce org alias as authenticated in the sf CLI (sf org login device)
SF_TARGET_ORG=atfx

# Port the HTTP server listens on
PORT=8787

# Optional: full path to the sf binary if it is not on PATH (e.g. for systemd)
# SF_BIN=/usr/local/bin/sf

# Local smoke tests without a live sf session (pnpm smoke:local)
# SF_FIXTURE_MODE=mock

# Describe cache TTL in ms (default 3600000 = 1 hour)
# DESCRIBE_CACHE_TTL_MS=3600000

# Redis cache for REST/SOQL responses (recommended in production — VM uses redis-server)
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_MS=300000
