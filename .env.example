# Salesforce Connected App (ATFX org)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce REST API version (ATFX org is on v67.0)
SF_API_VERSION=67.0

# 32+ char random secret used to encrypt the JWE tokens issued to Claude
# Generate: openssl rand -base64 48
OAUTH_ENCRYPTION_SECRET=

# Public base URL of this deployment (no trailing slash)
# Local: http://localhost:3000  ·  Prod: https://salesforce-atfx-mcp.vercel.app
PUBLIC_BASE_URL=https://salesforce-atfx-mcp.vercel.app

# Exact-match allowlist of client redirect URIs (comma-separated, https only).
# Leave unset to use the built-in Claude web callbacks. Set this only if Claude
# uses a different callback or you add another client.
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
